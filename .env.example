# Server
APP_PORT=8080
APP_ENV=development
BASE_DOMAIN=kemasan3d.id

# Database (SQLite default or PostgreSQL)
# Opsi 1: SQLite (File database lokal / mudah dideploy tanpa setup server DB terpisah)
DATABASE_DRIVER=sqlite
DATABASE_URL=asta.db

# Opsi 2: PostgreSQL (Opsional jika ingin multi-server)
# DATABASE_DRIVER=postgres
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/kemasan3d_saas?sslmode=disable

# Redis (Task Queue & Caching)
REDIS_URL=localhost:6379

# Auth
JWT_SECRET=super-secret-key-3dkemasan-2026

# Storage (S3 / MinIO / Cloudflare R2)
S3_ENDPOINT=localhost:9000
S3_BUCKET=kemasan3d-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false
